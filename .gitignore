node_modules/
out/
dist/
release/
apps/desktop/release/
apps/desktop/out/
.studio/
*.log
.DS_Store
.vite/
*.local

# Prebuilt web player. Produced by `npm run build:web`; the exporter copies it.
apps/web-template/dist/

# Working notes, plans and decision records. Local by design, never versioned:
# a citation from the code to a document in here would resolve for nobody else,
# so the reasoning goes in the comment beside the code instead.
docs/

# Local Claude Code settings (may contain machine paths).
.claude/settings.local.json

# Credentials. None of these are in the repository today and none ever should be;
# the point is that a contributor's stray token never becomes a public commit.
.env
.env.*
.npmrc
.netrc
*.pem
*.key
*.p12
*.keystore

# Editor state. Ignored on this machine by a personal excludes file, which does
# nothing for anyone else who clones this.
.vscode/
.idea/
